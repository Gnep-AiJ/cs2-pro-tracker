generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum NewsStatus {
  DRAFT
  REVIEW
  PUBLISHED
  REJECTED
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  country     String?
  logoUrl     String?
  worldRank   Int?
  rankingPts  Int?
  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Player {
  id          String        @id @default(cuid())
  nickname    String        @unique
  realName    String?
  slug        String        @unique
  country     String?
  avatarUrl   String?
  role        String?
  faceitId    String?       @unique
  teamId      String?
  team        Team?         @relation(fields: [teamId], references: [id])
  stats       PlayerStats[]
  news        News[]
  matchStats  MatchPlayer[]
  isTracked   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([teamId])
}

model PlayerStats {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  elo       Int
  matches   Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  rating    Float?
  snapshot  DateTime @default(now())

  @@unique([playerId, snapshot])
  @@index([snapshot])
}

model Match {
  id          String        @id @default(cuid())
  sourceId    String?       @unique
  homeTeamId  String
  awayTeamId  String
  homeTeam    Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  event       String
  stage       String?
  bestOf      Int           @default(3)
  startsAt    DateTime
  status      MatchStatus   @default(UPCOMING)
  homeScore   Int?
  awayScore   Int?
  maps        Json?
  playerStats MatchPlayer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([startsAt, status])
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  playerId  String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player  @relation(fields: [playerId], references: [id])
  kills     Int?
  deaths    Int?
  assists   Int?
  rating    Float?
  isMvp     Boolean @default(false)

  @@unique([matchId, playerId])
}

model News {
  id          String     @id @default(cuid())
  sourceId    String?    @unique
  title       String
  sourceUrl   String
  sourceName  String
  original    String?
  summaryZh   String?
  imageUrl    String?
  category    String
  playerId    String?
  player      Player?    @relation(fields: [playerId], references: [id])
  status      NewsStatus @default(REVIEW)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([playerId])
}

model CrawlRun {
  id          String   @id @default(cuid())
  job         String
  status      String
  recordsSeen Int      @default(0)
  error       String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  @@index([job, startedAt])
}
